# 复制成 .env 后填写；.env 不会被提交
# 也可以完全不填，启动后在网页「设置」里填（存在 data/settings.json）

# 本地服务
PORT=8787
HOST=127.0.0.1

# 淘宝开放平台（https://open.taobao.com → 控制台 → 我的应用）
TOP_APP_KEY=
TOP_APP_SECRET=
# 店铺授权后拿到的 session（access_token），也可以走网页里的「授权登录」自动获取
TOP_SESSION=

# 网关，一般不用改
TOP_GATEWAY=https://eco.taobao.com/router/rest
TOP_AUTH_GATEWAY=https://oauth.taobao.com/authorize
TOP_TOKEN_GATEWAY=https://oauth.taobao.com/token
