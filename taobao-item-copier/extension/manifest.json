{
  "manifest_version": 3,
  "name": "淘宝店铺图片提取器 · 采集器",
  "version": "2.0.0",
  "description": "在你自己的浏览器里扫描淘宝/天猫店铺的全部宝贝链接并提取商品图片，全程只用你已登录的身份，不经过任何第三方服务器。",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "cookies", "tabs", "alarms"],
  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.alicdn.com/*",
    "*://*.1688.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "classic"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "淘宝店铺图片提取器"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*"
      ],
      "js": ["md5.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*", "http://localhost/*"]
  },
  "icons": {}
}
