{
  "manifest_version": 3,
  "name": "淘宝商品搬运台 · 采集器",
  "version": "0.2.0",
  "description": "在你自己的浏览器里采集淘宝/天猫店铺宝贝，并在商品发布页自动填表，全程只用你已登录的身份，不经过任何第三方服务器。",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "cookies", "tabs", "scripting", "alarms", "webNavigation"],
  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.alicdn.com/*",
    "*://*.1688.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "classic"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "淘宝商品搬运台"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*"
      ],
      "exclude_matches": [
        "*://myseller.taobao.com/*",
        "*://seller.taobao.com/*",
        "*://work.taobao.com/*",
        "*://qianniu.taobao.com/*",
        "*://qianiu.taobao.com/*",
        "*://qn.taobao.com/*"
      ],
      "js": ["md5.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://myseller.taobao.com/*",
        "*://seller.taobao.com/*",
        "*://sell.taobao.com/*",
        "*://work.taobao.com/*",
        "*://qianniu.taobao.com/*",
        "*://qianiu.taobao.com/*",
        "*://qn.taobao.com/*",
        "*://item.upload.taobao.com/*",
        "*://*.tmall.com/sell*/*"
      ],
      "js": ["fill-engine.js", "autofill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fill-engine.js", "autofill.js"],
      "matches": ["*://*.taobao.com/*", "*://*.tmall.com/*"]
    }
  ],
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*", "http://localhost/*"]
  },
  "icons": {}
}
